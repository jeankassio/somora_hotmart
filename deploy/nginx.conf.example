# Configure the certificate paths with aaPanel, then include this server content.
server {
    listen 80;
    server_name hotmart.somora.media;
    return 301 https://hotmart.somora.media$request_uri;
}

server {
    listen 443 ssl;
    server_name hotmart.somora.media;
    root /www/wwwroot/hotmart.somora.media;
    index index.html;

    ssl_certificate /www/server/panel/vhost/cert/hotmart.somora.media/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/hotmart.somora.media/privkey.pem;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https://api.somora.media; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;

    # No SPA fallback for unknown assets; a missing script must return 404.
    location / { try_files $uri $uri/ =404; }
    location = /config.js {
        expires -1;
        try_files $uri =404;
    }
    location = /index.html {
        expires -1;
        try_files $uri =404;
    }
    location ~ /\. { deny all; }
    location ~* \.(?:md|test\.mjs|conf\.example|log)$ { deny all; }
}
